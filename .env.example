# MailFlow Server Environment Variables
# Copy this to server/.env for local development.
# On Vercel, set these in the project's Environment Variables dashboard.

PORT=5000
NODE_ENV=production

# Public URL of the deployed Vercel project (no trailing slash).
# Vercel sets VERCEL_URL automatically, but CLIENT_URL takes priority.
# Set this explicitly in Vercel's dashboard once you know the deployment URL:
#   e.g. https://mail-rishi.vercel.app
CLIENT_URL=https://your-project.vercel.app

# Google OAuth 2.0 Credentials (from Google Cloud Console)
# Authorized redirect URI to register in GCP:
#   https://your-project.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-project.vercel.app/api/auth/google/callback
